{
  "openapi": "3.1.0",
  "info": {
    "title": "Memory Card",
    "description": "Video game collection manager for Home Assistant",
    "license": {
      "name": "GPL-3.0-only",
      "identifier": "GPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/devices": {
      "get": {
        "tags": [
          "devices"
        ],
        "operationId": "listDevices",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Device"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "devices"
        ],
        "operationId": "createDevice",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Device"
                }
              }
            }
          },
          "409": {
            "description": "`name_taken`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Includes `unknown_platform`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices/{id}": {
      "put": {
        "tags": [
          "devices"
        ],
        "operationId": "updateDevice",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Device"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`name_taken`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Includes `unknown_platform`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "devices"
        ],
        "operationId": "deleteDevice",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted; its copies keep existing with no device"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/export.csv": {
      "get": {
        "tags": [
          "transfer"
        ],
        "operationId": "exportCsv",
        "responses": {
          "200": {
            "description": "One row per copy, plus games without copies",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/import": {
      "post": {
        "tags": [
          "transfer"
        ],
        "operationId": "runImport",
        "requestBody": {
          "content": {
            "text/csv": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResult"
                }
              }
            }
          },
          "422": {
            "description": "`import_invalid`: preview the file to see why",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/import/preview": {
      "post": {
        "tags": [
          "transfer"
        ],
        "operationId": "previewImport",
        "requestBody": {
          "content": {
            "text/csv": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportPreview"
                }
              }
            }
          }
        }
      }
    },
    "/api/import/template.csv": {
      "get": {
        "tags": [
          "transfer"
        ],
        "operationId": "importTemplate",
        "responses": {
          "200": {
            "description": "Header row only",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/platforms": {
      "get": {
        "tags": [
          "platforms"
        ],
        "operationId": "listPlatforms",
        "responses": {
          "200": {
            "description": "All platforms, active or not, in list order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Platform"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "platforms"
        ],
        "operationId": "createPlatform",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlatformInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Platform"
                }
              }
            }
          },
          "409": {
            "description": "`name_taken`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/platforms/order": {
      "put": {
        "tags": [
          "platforms"
        ],
        "operationId": "reorderPlatforms",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlatformOrder"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Platform"
                  }
                }
              }
            }
          },
          "422": {
            "description": "`invalid_order`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/platforms/{id}": {
      "put": {
        "tags": [
          "platforms"
        ],
        "operationId": "updatePlatform",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlatformInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Platform"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`name_taken`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "platforms"
        ],
        "operationId": "deletePlatform",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {},
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`platform_in_use`: releases or devices use it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "tags": [
          "status"
        ],
        "operationId": "getStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/stores": {
      "get": {
        "tags": [
          "stores"
        ],
        "operationId": "listStores",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Store"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "stores"
        ],
        "operationId": "createStore",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StoreInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Store"
                }
              }
            }
          },
          "409": {
            "description": "`name_taken`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/stores/{id}": {
      "put": {
        "tags": [
          "stores"
        ],
        "operationId": "updateStore",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StoreInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Store"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`name_taken`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "stores"
        ],
        "operationId": "deleteStore",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted; its copies keep existing with no store"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Device": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "active",
          "platform_ids",
          "copy_count"
        ],
        "properties": {
          "active": {
            "type": "boolean"
          },
          "copy_count": {
            "type": "integer",
            "format": "int64",
            "description": "Copies assigned to this device, of any status."
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "$ref": "#/components/schemas/DeviceKind"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "platform_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Platforms this device plays, in platform list order."
          }
        }
      },
      "DeviceInput": {
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "active": {
            "type": "boolean"
          },
          "kind": {
            "$ref": "#/components/schemas/DeviceKind"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "platform_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "DeviceKind": {
        "type": "string",
        "enum": [
          "console",
          "handheld",
          "pc",
          "account"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "description": "Error body. `code` is a stable key the UI translates; it never carries\ndisplay text. `field` names the input field at fault, when there is one.",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "FileIssue": {
        "type": "object",
        "description": "A problem with the file as a whole; no rows are read when there is one.",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "column": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ImportPreview": {
        "type": "object",
        "required": [
          "summary",
          "new_platforms",
          "new_devices",
          "new_stores",
          "rows"
        ],
        "properties": {
          "file_issue": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/FileIssue",
                "description": "Set when the file cannot be read at all; everything else is then empty."
              },
              {
                "type": "null"
              }
            ]
          },
          "new_devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NewDeviceReport"
            }
          },
          "new_platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "new_stores": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RowReport"
            }
          },
          "summary": {
            "$ref": "#/components/schemas/ImportSummary"
          }
        }
      },
      "ImportResult": {
        "type": "object",
        "required": [
          "summary"
        ],
        "properties": {
          "summary": {
            "$ref": "#/components/schemas/ImportSummary"
          }
        }
      },
      "ImportSummary": {
        "type": "object",
        "required": [
          "rows",
          "new_games",
          "updated_games",
          "new_releases",
          "updated_releases",
          "new_copies",
          "updated_copies",
          "unchanged_copies",
          "game_only_rows",
          "error_rows",
          "warning_rows"
        ],
        "properties": {
          "error_rows": {
            "type": "integer",
            "minimum": 0
          },
          "game_only_rows": {
            "type": "integer",
            "minimum": 0
          },
          "new_copies": {
            "type": "integer",
            "minimum": 0
          },
          "new_games": {
            "type": "integer",
            "minimum": 0
          },
          "new_releases": {
            "type": "integer",
            "minimum": 0
          },
          "rows": {
            "type": "integer",
            "minimum": 0
          },
          "unchanged_copies": {
            "type": "integer",
            "minimum": 0
          },
          "updated_copies": {
            "type": "integer",
            "minimum": 0
          },
          "updated_games": {
            "type": "integer",
            "minimum": 0
          },
          "updated_releases": {
            "type": "integer",
            "minimum": 0
          },
          "warning_rows": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "NewDeviceReport": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "platforms"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/DeviceKind"
          },
          "name": {
            "type": "string"
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Platform": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "active",
          "sort_order",
          "release_count",
          "device_count"
        ],
        "properties": {
          "abbreviation": {
            "type": [
              "string",
              "null"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "device_count": {
            "type": "integer",
            "format": "int64"
          },
          "family": {
            "type": [
              "string",
              "null"
            ]
          },
          "generation": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "igdb_platform_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "release_count": {
            "type": "integer",
            "format": "int64"
          },
          "slug": {
            "type": "string"
          },
          "sort_order": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "PlatformInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "abbreviation": {
            "type": [
              "string",
              "null"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "PlatformOrder": {
        "type": "object",
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Every platform id, once, in the new order."
          }
        }
      },
      "RowAction": {
        "type": "string",
        "enum": [
          "new_copy",
          "update_copy",
          "unchanged",
          "game_only",
          "error"
        ]
      },
      "RowIssue": {
        "type": "object",
        "required": [
          "column",
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "column": {
            "type": "string"
          },
          "error": {
            "type": "boolean",
            "description": "Errors block the import; warnings do not."
          }
        }
      },
      "RowReport": {
        "type": "object",
        "required": [
          "line",
          "action",
          "issues"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/RowAction"
          },
          "game_title": {
            "type": [
              "string",
              "null"
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RowIssue"
            }
          },
          "line": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "platform": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "version",
          "igdb_configured",
          "games",
          "owned_copies"
        ],
        "properties": {
          "games": {
