    "e2e": "npm run test -w e2e",
    "licenses": "node scripts/check-npm-licenses.mjs"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
