  "query": "SELECT g.id AS \"game_id!\", g.title, COUNT(*) AS \"sessions!: i64\",\n                  COALESCE(SUM(s.minutes), 0) AS \"minutes!: i64\"\n           FROM play_sessions s JOIN games g ON g.id = s.game_id\n           GROUP BY g.id\n           ORDER BY COUNT(*) DESC, SUM(s.minutes) DESC, g.sort_title\n           LIMIT ?",
